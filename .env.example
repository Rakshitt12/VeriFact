# Environment Configuration for AI-Powered News Credibility & Verification System

# Application
APP_NAME="AI News Credibility Verification Engine"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging
LOG_LEVEL="INFO"

# LLM Providers (for Claim Extraction & Evidence Analysis)
# GOOGLE_API_KEY=""
# OPENAI_API_KEY=""

# News Retrieval Providers
# NEWS_API_KEY=""
# BING_NEWS_API_KEY=""

# Web Retrieval Providers
# GOOGLE_CSE_API_KEY=""
# GOOGLE_CSE_CX=""
# TAVILY_API_KEY=""
# BRAVE_SEARCH_API_KEY=""

# Fact-Check Providers
# GOOGLE_FACTCHECK_API_KEY=""

# Frontend (VeriFact client, read by Vite at build/dev time)
# Base URL of the FastAPI backend. Same-origin ("") works behind a reverse proxy.
# VITE_API_BASE_URL="http://localhost:8000"
